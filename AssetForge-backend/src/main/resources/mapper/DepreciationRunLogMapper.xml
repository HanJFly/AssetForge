<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hjf.mapper.DepreciationRunLogMapper">

    <select id="queryPage" resultType="com.hjf.vo.DepreciationRunLogPageRecord">
        select id,
             run_month,
            processed_count,
            skipped_count,
            total_monthly_depreciation,
            started_at,
            completed_at,
            status,
            error_message
          from depreciation_run_log
        <where>
            <if test="runMonth != null and runMonth != ''">
                run_month = #{runMonth}
            </if>
        </where>
    </select>
</mapper>
